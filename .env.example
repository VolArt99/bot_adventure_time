# Telegram
# BOT_TOKEN=
# GROUP_ID=
# OWNER_ID=
# ADMIN_IDS=
# OWNER_CONTACT=

# Runtime
# ENV=dev
# TIMEZONE=Europe/Moscow
# AUTO_INIT_DB=0
# DIGEST_DAY_OF_WEEK=1
# DIGEST_HOUR=10

# Optional integrations
# WEATHER_API_KEY=

# Access limits / command policy
# ADMIN_DAILY_COMMAND_LIMIT=50
# MEMBER_DAILY_COMMAND_LIMIT=25
# OUTSIDER_START_DAILY_LIMIT=5
# OUTSIDER_ALLOWED_COMMANDS=start
# MEMBER_ALLOWED_COMMANDS defaults to bot.commands.DEFAULT_MEMBER_ALLOWED_COMMANDS
# RESTRICTED_COMMANDS=debug_info,list_topics,update_topic_names,admin_report,random_pairs

# YDB
# YDB_ENDPOINT=
# YDB_DATABASE=/ru-central1/.../...
# YDB_SESSION_POOL_SIZE=30
# YDB_PATCH_TX_EXECUTE=1
# Choose one auth method:
# YDB_SERVICE_ACCOUNT_KEY_FILE_CREDENTIALS=/path/to/key.json
# YDB_SERVICE_ACCOUNT_KEY_CONTENT_CREDENTIALS={...}
# YDB_ACCESS_TOKEN_CREDENTIALS=
# YDB_METADATA_CREDENTIALS=1
# YDB_ANONYMOUS_CREDENTIALS=1
