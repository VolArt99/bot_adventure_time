# Telegram
# BOT_TOKEN=
# GROUP_ID=
# OWNER_ID=
# ADMIN_IDS=
# OWNER_CONTACT=

# Runtime
# ENV=production
# TIMEZONE=Europe/Helsinki
# AUTO_INIT_DB=1
# DIGEST_DAY_OF_WEEK=1
# DIGEST_HOUR=10

# Optional integrations
# WEATHER_API_KEY=          # OpenWeatherMap — погода на карточках в день события

# Access limits / command policy
# ADMIN_DAILY_COMMAND_LIMIT=50
# MEMBER_DAILY_COMMAND_LIMIT=25
# OUTSIDER_START_DAILY_LIMIT=5
# OUTSIDER_ALLOWED_COMMANDS=start,donate
# MEMBER_ALLOWED_COMMANDS defaults to bot.commands.DEFAULT_MEMBER_ALLOWED_COMMANDS
# RESTRICTED_COMMANDS=debug_info,list_topics,update_topic_names,admin_report,random_pairs

# Donations — URL-кнопки в /donate (раздел «Помощь» в /menu)
# DONATION_SBERBANK_URL=https://...
# DONATION_TBANK_URL=https://...

# PostgreSQL (VDS / Docker Compose)
# POSTGRES_USER=bot
# POSTGRES_DB=adventure_time
# POSTGRES_PASSWORD=change_me_strong_password
# DATABASE_URL=postgresql://bot:change_me@postgres:5432/adventure_time
# DB_POOL_MIN_SIZE=1
# DB_POOL_MAX_SIZE=5

# Alternative PostgreSQL settings if DATABASE_URL is not set:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=bot
# PGPASSWORD=change_me
# PGDATABASE=adventure_time

# Брендинг (BRAND_VOICE, SEASON_COPY) — в bot/utils/design.py, env не требуется
